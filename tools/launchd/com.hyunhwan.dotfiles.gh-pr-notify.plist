<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for install.sh: __HOME__ is replaced with $HOME and the result is
  written to ~/Library/LaunchAgents/. Runs tools/gh-pr-notify.sh every 5 minutes.
  Manual control:
    launchctl kickstart -k gui/$UID/com.hyunhwan.dotfiles.gh-pr-notify   # run now
    launchctl bootout   gui/$UID/com.hyunhwan.dotfiles.gh-pr-notify      # stop
  Logs: ~/.local/state/gh-pr-notify/launchd.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hyunhwan.dotfiles.gh-pr-notify</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/dotfiles/tools/gh-pr-notify.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/gh-pr-notify/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/gh-pr-notify/launchd.log</string>
</dict>
</plist>
