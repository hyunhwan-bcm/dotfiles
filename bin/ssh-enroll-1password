#!/usr/bin/env bash
#
# ssh-enroll-1password — install the 1Password SSH public key on remote hosts
#
# Usage:
#   ssh-enroll-1password                 # every online Linux/macOS tailnet peer
#   ssh-enroll-1password studio anjanda  # only these hosts
#   ssh-enroll-1password hwan@jani-spark # override the login name for one host
#
# Each host is enrolled with ssh-copy-id, which authenticates however it can
# today (existing key, password) and appends ~/.ssh/id_1password.pub to the
# remote ~/.ssh/authorized_keys. Login names come from ~/.ssh/config.
# Afterwards `ssh <host>` works with the key in 1Password, and hops between
# tailnet machines reuse it through agent forwarding.
#
set -uo pipefail

pub="$HOME/.ssh/id_1password.pub"
if [ ! -f "$pub" ]; then
    printf 'missing %s — run install.sh (or startup.sh) first\n' "$pub" >&2
    exit 1
fi

# Without a reachable agent, ssh-copy-id can only fall back to passwords and
# the 1Password key itself can never be offered. This is the usual situation
# when running inside an SSH session that was opened without agent forwarding.
if ! ssh-add -l >/dev/null 2>&1; then
    printf 'warning: no SSH agent reachable from this shell (ssh-add -l failed).\n' >&2
    if [ -n "${SSH_CONNECTION:-}" ]; then
        printf '         You are inside an SSH session from %s with no forwarded agent.\n' "${SSH_CONNECTION%% *}" >&2
        printf '         Run this on the machine where 1Password is unlocked, or reconnect with agent forwarding (ssh -A).\n' >&2
    else
        printf '         Is 1Password running with Settings > Developer > SSH agent enabled?\n' >&2
    fi
    printf '         Continuing; hosts that require a key will fail, password logins still work.\n\n' >&2
fi

tailscale_bin() {
    if command -v tailscale >/dev/null 2>&1; then
        echo tailscale
    elif [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
        echo /Applications/Tailscale.app/Contents/MacOS/Tailscale
    else
        return 1
    fi
}

# Online Linux/macOS peers from `tailscale status` (self excluded).
# Columns: <ip> <hostname> <owner> <os> <status…>
tailnet_hosts() {
    local ts
    ts=$(tailscale_bin) || { printf 'tailscale CLI not found; pass hosts explicitly\n' >&2; return 1; }
    "$ts" status --self=false 2>/dev/null \
        | awk '($4 == "linux" || $4 == "macOS") && $0 !~ /offline/ { print $2 }'
}

if [ $# -gt 0 ]; then
    hosts=("$@")
else
    hosts=()
    while IFS= read -r h; do [ -n "$h" ] && hosts+=("$h"); done < <(tailnet_hosts)
    if [ ${#hosts[@]} -eq 0 ]; then
        printf 'no online Linux/macOS peers found on the tailnet\n' >&2
        exit 1
    fi
fi

ok=() failed=()
for h in "${hosts[@]}"; do
    login=$(ssh -G "$h" 2>/dev/null | awk '$1 == "user" { print $2 }')
    printf '\n==> %s (login: %s)\n' "$h" "${login:-?}"
    # -f: the private half lives only in 1Password, so ssh-copy-id must not
    # look for it on disk next to the .pub file.
    if ssh-copy-id -f -i "$pub" -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new "$h"; then
        ok+=("$h")
    else
        failed+=("$h")
    fi
done

printf '\nenrolled: %s\n' "${ok[*]:-none}"
if [ ${#failed[@]} -gt 0 ]; then
    printf 'failed:   %s\n' "${failed[*]}"
    printf 'For a failed host, set its login name in ~/.ssh/config (or pass user@host) and rerun.\n'
    exit 1
fi
