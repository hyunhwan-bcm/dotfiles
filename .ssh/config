# ~/.ssh/config — managed by dotfiles (file-level symlink into the repo).
#
# Do not add machine-specific hosts here. Put them in ~/.ssh/config.local
# (or any file under ~/.ssh/config.d/), both untracked. ssh takes the FIRST
# value it sees for each option, so those files always win over this one.

Include ~/.ssh/config.local
Include ~/.ssh/config.d/*

# ── One key, stored in 1Password ─────────────────────────────────────────────
# The private key lives only in 1Password; its SSH agent signs on request.
# The public half is tracked at ~/.ssh/id_1password.pub and install.sh adds it
# to ~/.ssh/authorized_keys on every machine that runs these dotfiles.
#
# Use the local 1Password agent when it exists AND this shell is not itself an
# SSH session. Inside an SSH session the agent forwarded from the origin
# machine is used instead, so hop-to-hop connections need no local unlock.
Match host * exec "test -z \"$SSH_CONNECTION\" && test -S ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Match host * exec "test -z \"$SSH_CONNECTION\" && test -S ~/.1password/agent.sock"
  IdentityAgent ~/.1password/agent.sock

# ── Tailnet (tail5aee49.ts.net) ──────────────────────────────────────────────
# Per-host login names. Add a block here when a new device joins the tailnet.
Host diginda-spark
  User hyunhwan

Host studio 2katzs-macbook-pro
  User 2katz

# Bare MagicDNS names resolve to the fully qualified tailnet name, so they
# work even when the tailnet search domain is not installed on this machine.
Host hwan-pro-liulab studio 2katzs-macbook-pro diginda-spark anjanda jani-spark
  HostName %h.tail5aee49.ts.net

# Applies to every tailnet device, by bare name or FQDN.
Host *.tail5aee49.ts.net hwan-pro-liulab studio 2katzs-macbook-pro diginda-spark anjanda jani-spark mac-mini macbook-air-2 lnr01m-collab01
  # Carry the 1Password agent along so the next hop uses the same key.
  ForwardAgent yes
  # Tailscale already authenticates the peer; only trust-on-first-use is left.
  StrictHostKeyChecking accept-new
  # Reuse one connection for repeated ssh/scp/rsync/VS Code sessions.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m

# ── Defaults for everything ──────────────────────────────────────────────────
Host *
  ServerAliveInterval 30
  ServerAliveCountMax 4
  AddKeysToAgent no
